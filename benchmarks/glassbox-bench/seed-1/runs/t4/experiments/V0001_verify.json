  "code": "def predict(tokens, prompt):\n    # tokens: [BOS, t1..t6]; ids: fu=2 ko=3 ni=4 pa=5 tu=6\n    last = tokens[6]\n    # mlp0 turns the last token into a pointer (E0013, E0014); head 1.1 attends one-hot there (E0005-E0007)\n    ptr = {3: 1, 4: 3}.get(last, 2)   # ko->pos1, ni->pos3, fu/pa/tu->pos2\n    x = tokens[ptr]\n    # mlp1 maps (last token, copied token) to the output (E0008); table read off E0001\n    TABLE = {\n        2: {2: 3, 3: 3, 4: 3, 5: 4, 6: 6},\n        3: {2: 3, 3: 4, 4: 4, 5: 2, 6: 5},\n        4: {2: 5, 3: 2, 4: 4, 5: 3, 6: 6},\n        5: {2: 5, 3: 5, 4: 2, 5: 2, 6: 5},\n        6: {2: 2, 3: 6, 4: 3, 5: 4, 6: 3},\n    }\n    return TABLE[last][x]\n",
